{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared MCP service registry",
  "type": "object",
  "required": ["version", "protocolVersion", "defaults", "servers"],
  "properties": {
    "version": { "const": 1 },
    "protocolVersion": { "type": "string", "minLength": 1 },
    "defaults": {
      "type": "object",
      "required": ["host", "basePort", "path", "healthPath"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "basePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string", "pattern": "^/" },
        "healthPath": { "type": "string", "pattern": "^/" }
      },
      "additionalProperties": true
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "displayName", "mode"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["shared", "optional", "isolated"] },
          "portOffset": { "type": "integer", "minimum": 0 },
          "metricsOffset": { "type": "integer", "minimum": 0 },
          "core": { "type": "boolean" },
          "critical": { "type": "boolean" },
          "topology": { "enum": ["split", "monolithic"] },
          "runtimeCommand": { "type": "string", "minLength": 1 },
          "runtimeArgs": { "type": "array", "items": { "type": "string" } },
          "runtimeEnv": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
