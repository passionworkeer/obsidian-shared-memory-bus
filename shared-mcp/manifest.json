{
  "version": 1,
  "protocolVersion": "2024-11-05",
  "defaults": {
    "host": "127.0.0.1",
    "basePort": 9330,
    "path": "/mcp",
    "healthPath": "/healthz"
  },
  "servers": [
    {
      "id": "context7",
      "displayName": "Context7",
      "mode": "shared",
      "port": 9331,
      "probeType": "mcp-initialize",
      "stdioCommandCandidatesWindows": [
        "context7-mcp.cmd",
        "npx -y @upstash/context7-mcp@latest"
      ],
      "stdioCommandPosix": "npx -y @upstash/context7-mcp@latest",
      "notes": "Stateless documentation/code search MCP. Strong candidate for one shared instance."
    },
    {
      "id": "fetch",
      "displayName": "Fetch",
      "mode": "shared",
      "port": 9332,
      "probeType": "mcp-initialize",
      "stdioCommandWindows": "{{python}} -m mcp_server_fetch",
      "stdioCommandPosix": "{{python}} -m mcp_server_fetch",
      "notes": "Stateless fetch MCP. Safe to centralize."
    },
    {
      "id": "time",
      "displayName": "Time",
      "mode": "shared",
      "port": 9333,
      "probeType": "mcp-initialize",
      "stdioCommandWindows": "{{python}} -m mcp_server_time",
      "stdioCommandPosix": "{{python}} -m mcp_server_time",
      "notes": "Stateless utility MCP. Safe to centralize."
    },
    {
      "id": "sequential-thinking",
      "displayName": "Sequential Thinking",
      "mode": "shared",
      "port": 9334,
      "probeType": "mcp-initialize",
      "stdioCommandCandidatesWindows": [
        "mcp-server-sequential-thinking.cmd",
        "npx -y @modelcontextprotocol/server-sequential-thinking@latest"
      ],
      "stdioCommandPosix": "npx -y @modelcontextprotocol/server-sequential-thinking@latest",
      "notes": "Mostly stateless reasoning helper. Safe to centralize."
    },
    {
      "id": "obsidian",
      "displayName": "Obsidian",
      "mode": "shared",
      "port": 9335,
      "stdioCommandWindows": "{{powershell}} -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File {{obsidianRunner}}",
      "stdioCommandPosix": "{{powershell}} -NoProfile -File {{obsidianRunner}}",
      "notes": "Already points at one canonical vault. Shared mode avoids duplicated launch cost."
    },
    {
      "id": "MiniMax",
      "displayName": "MiniMax Coding Plan",
      "mode": "optional",
      "port": 9336,
      "stdioCommandWindows": "{{powershell}} -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File {{minimaxRunner}}",
      "stdioCommandPosix": "{{powershell}} -NoProfile -File {{minimaxRunner}}",
      "notes": "Optional shared MiniMax MCP. Requires MINIMAX_API_KEY and an installed minimax-coding-plan-mcp executable, or set MINIMAX_MCP_COMMAND explicitly."
    },
    {
      "id": "memory-retrieval",
      "displayName": "Memory · Retrieval",
      "mode": "shared",
      "port": 9338,
      "probeType": "mcp-initialize",
      "startupProbeTimeoutSeconds": 10,
      "startupProbeAttempts": 45,
      "stdioCommandWindows": "{{node}} --experimental-default-type=module \"{{omniMemoryServer}}\"",
      "stdioCommandPosix": "{{node}} --experimental-default-type=module {{omniMemoryServer}}",
      "stdioEnv": {
        "AI_MEMORY_SERVER_MODE": "retrieval",
        "AI_MEMORY_METRICS_PORT": "9338"
      },
      "isolatedSubprocess": {
        "id": "search-worker",
        "description": "Python search worker process managed by the memory MCP server",
        "managedBy": "memory-retrieval",
        "script": "{{searchWorkerService}}",
        "isolation": "isolated-subprocess",
        "restartPolicy": "always",
        "maxRestarts": 5,
        "circuitWindowMs": 300000
      },
      "notes": "I-HIGH-1 stage 3: read-only retrieval + status queries (14 tools). Hosts the search-worker isolated subprocess."
    },
    {
      "id": "memory-bridge",
      "displayName": "Memory · Bridge",
      "mode": "shared",
      "port": 9339,
      "probeType": "mcp-initialize",
      "stdioCommandWindows": "{{node}} --experimental-default-type=module \"{{omniMemoryServer}}\"",
      "stdioCommandPosix": "{{node}} --experimental-default-type=module {{omniMemoryServer}}",
      "stdioEnv": {
        "AI_MEMORY_SERVER_MODE": "bridge",
        "AI_MEMORY_METRICS_PORT": "9339"
      },
      "notes": "I-HIGH-1 stage 3: claude-mem / blackboard cross-tool bridge (6 tools)."
    },
    {
      "id": "memory-dream",
      "displayName": "Memory · Dream",
      "mode": "shared",
      "port": 9340,
      "probeType": "mcp-initialize",
      "stdioCommandWindows": "{{node}} --experimental-default-type=module \"{{omniMemoryServer}}\"",
      "stdioCommandPosix": "{{node}} --experimental-default-type=module {{omniMemoryServer}}",
      "stdioEnv": {
        "AI_MEMORY_SERVER_MODE": "dream",
        "AI_MEMORY_METRICS_PORT": "9340"
      },
      "notes": "I-HIGH-1 stage 3: async rebuild + nightly dream (3 tools)."
    },
    {
      "id": "memory-mgmt",
      "displayName": "Memory · Mgmt",
      "mode": "shared",
      "port": 9341,
      "probeType": "mcp-initialize",
      "stdioCommandWindows": "{{node}} --experimental-default-type=module \"{{omniMemoryServer}}\"",
      "stdioCommandPosix": "{{node}} --experimental-default-type=module {{omniMemoryServer}}",
      "stdioEnv": {
        "AI_MEMORY_SERVER_MODE": "mgmt",
        "AI_MEMORY_METRICS_PORT": "9341"
      },
      "notes": "I-HIGH-1 stage 3: index / embedding runtime management + KG queries (6 tools)."
    },
    {
      "id": "memory",
      "displayName": "Memory (monolithic, legacy)",
      "mode": "shared",
      "port": 9338,
      "probeType": "mcp-initialize",
      "startupProbeTimeoutSeconds": 10,
      "startupProbeAttempts": 45,
      "stdioCommandWindows": "{{node}} --experimental-default-type=module \"{{omniMemoryServer}}\"",
      "stdioCommandPosix": "{{node}} --experimental-default-type=module {{omniMemoryServer}}",
      "stdioEnv": {
        "AI_MEMORY_SERVER_MODE": "all",
        "AI_MEMORY_METRICS_PORT": "9338"
      },
      "legacy": true,
      "notes": "Legacy monolithic memory server. Only spawned when AI_MEMORY_SERVER_MODE=monolithic/all (SERVER-SPLIT.md §8.2 compatibility guarantee). Port 9338 is shared with memory-retrieval but the two are mutually exclusive — see spawn-plan.js."
    },
    {
      "id": "playwright",
      "displayName": "Playwright",
      "mode": "optional",
      "port": 9337,
      "healthPath": "/mcp",
      "launchCommandCandidatesWindows": [
        "playwright-mcp.cmd --host {{host}} --port {{port}} --headless --isolated --allowed-hosts=*",
        "npx @playwright/mcp@latest --host {{host}} --port {{port}} --headless --isolated --allowed-hosts=*"
      ],
      "launchCommandPosix": "npx @playwright/mcp@latest --host {{host}} --port {{port}} --headless --isolated --allowed-hosts=*",
      "probeType": "mcp-initialize",
      "notes": "Standalone Playwright MCP HTTP server on 9337. Multiple clients can share one backend while keeping isolated MCP sessions and browser profiles."
    },
    {
      "id": "pencil",
      "displayName": "Pencil",
      "mode": "isolated",
      "notes": "Desktop design app state is UI-bound and should stay isolated per client."
    }
  ]
}
