{
  "version": 1,
  "protocolVersion": "2024-11-05",
  "defaults": {
    "host": "127.0.0.1",
    "basePort": 9330,
    "path": "/mcp",
    "healthPath": "/healthz"
  },
  "servers": [
    # NOTE: pin versions - update periodically
    {
      "id": "context7",
      "displayName": "Context7",
      "mode": "shared",
      "port": 9331,
      "stdioCommand": "cmd /c npx -y @upstash/context7-mcp@2.3.1",
      "notes": "Stateless documentation/code search MCP. Strong candidate for one shared instance."
    },
    {
      "id": "fetch",
      "displayName": "Fetch",
      "mode": "shared",
      "port": 9332,
      "stdioCommand": "uvx mcp-server-fetch@1.2.0",
      "notes": "Stateless fetch MCP. Safe to centralize."
    },
    {
      "id": "time",
      "displayName": "Time",
      "mode": "shared",
      "port": 9333,
      "stdioCommand": "uvx mcp-server-time@1.2.0",
      "notes": "Stateless utility MCP. Safe to centralize."
    },
    {
      "id": "sequential-thinking",
      "displayName": "Sequential Thinking",
      "mode": "shared",
      "port": 9334,
      "stdioCommand": "cmd /c npx -y @modelcontextprotocol/server-sequential-thinking@1.3.0",
      "notes": "Mostly stateless reasoning helper. Safe to centralize."
    },
    {
      "id": "obsidian",
      "displayName": "Obsidian",
      "mode": "shared",
      "port": 9335,
      "stdioCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.ai-memory\\run-obsidian-mcp.ps1\"",
      "notes": "Already points at one canonical vault. Shared mode avoids duplicated launch cost."
    },
    {
      "id": "MiniMax",
      "displayName": "MiniMax Coding Plan",
      "mode": "shared",
      "port": 9336,
      "stdioCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.ai-memory\\run-minimax-mcp.ps1\"",
      "notes": "Optional shared MiniMax MCP. Requires MINIMAX_API_KEY and an installed minimax-coding-plan-mcp executable, or set MINIMAX_MCP_COMMAND explicitly."
    },
    {
      "id": "memory",
      "displayName": "Memory",
      "mode": "shared",
      "port": 9338,
      "stdioCommand": "cmd /c node --experimental-default-type=module \"%USERPROFILE%\\.ai-memory\\shared-mcp\\omni-memory-server.js\"",
      "notes": "Unified shared memory interface over canonical Obsidian structured memory with bm25/dense/hybrid retrieval, embeddings rebuild, claude-mem compatibility, and OpenClaw blackboard tools."
    },
    {
      "id": "playwright",
      "displayName": "Playwright",
      "mode": "optional",
      "port": 9337,
      "healthPath": "/mcp",
      "launchCommand": "npx @playwright/mcp@1.4.0 --host 127.0.0.1 --port 9337 --headless --isolated",
      "probeType": "mcp-initialize",
      "notes": "Standalone Playwright MCP HTTP server on 9337. Multiple clients can share one backend while keeping isolated MCP sessions and browser profiles."
    },
    {
      "id": "pencil",
      "displayName": "Pencil",
      "mode": "isolated",
      "notes": "Desktop design app state is UI-bound and should stay isolated per client."
    }
  ]
}
