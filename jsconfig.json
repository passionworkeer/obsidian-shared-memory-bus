{
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "ES2022",
    "checkJs": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "module": "ES2022"
  },
  "typeRoots": ["./types", "./node_modules/@types"],
  "include": ["bus/**/*.js", "ops/**/*.js", "shared-mcp/**/*.js", "cli/**/*.js", "retrieval/**/*.js"],
  "exclude": ["node_modules", "shared-mcp/node_modules", "ops/node_modules", "~/.ai-memory", "coverage"]
}
