        "ok": { "type": "boolean" },
        "error": { "type": "string" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "number", "description": "Row ID." },
              "repo": { "type": "string", "description": "Repository name." },
              "issue_number": { "type": "number", "description": "GitHub issue number." },
              "issue_title": { "type": "string", "description": "Issue title." },
              "state": { "type": "string", "description": "Task state: PENDING, ACTIVE, DONE, etc." },
              "assigned_agent": { "type": "string", "description": "OpenClaw agent lane." },
              "processor": { "type": "string" },
