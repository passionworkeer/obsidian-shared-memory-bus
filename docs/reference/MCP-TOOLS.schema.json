    "get_blackboard_tasks.input": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "get_blackboard_tasks — input",
      "type": "object",
      "properties": {
        "limit": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Maximum rows to return."
        },
        "state": {
          "type": "string",
          "description": "Optional single state filter (case-insensitive, normalized to uppercase)."
        },
        "states": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Optional multiple state filters, e.g. ['PENDING', 'ACTIVE']."
        }
      },
      "additionalProperties": false
    },

