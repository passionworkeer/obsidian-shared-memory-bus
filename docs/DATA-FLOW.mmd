}
```

### KG Triple (SQLite)

```sql
-- Knowledge graph stores entity-relationship triples with temporal validity
INSERT INTO triples (
  entity_id, entity_name, entity_type,
  relation,
  target_id, target_name, target_type,
  valid_from, valid_to, source_record_id
) VALUES (
  'alice', 'Alice', 'person',
  'works_on',
  'mem_palace', 'MemPalace', 'project',
  '2026-01-01', NULL, 'rec_abc123'
);
```

