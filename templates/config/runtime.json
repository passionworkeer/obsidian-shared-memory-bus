{
  "embeddings": {
    "activeProfile": "hash-local",
    "defaults": {
      "timeoutMs": 120000,
      "requestDelayMs": 0,
      "batchSize": 0,
      "allowBatchFallback": false
    },
    "providers": {
      "hash-local": {
        "adapter": "hash",
        "model": "hashing-v1",
        "description": "Zero-dependency local fallback"
      },
      "transformer-local": {
        "adapter": "transformer",
        "model": "all-MiniLM-L6-v2",
        "description": "Local sentence-transformers runtime"
      },
      "openai-compatible-remote": {
        "adapter": "openai-compatible",
        "baseUrl": "https://example.com/v1",
        "apiKeyEnv": "AI_MEMORY_EMBED_API_KEY",
        "description": "Any OpenAI-compatible embeddings endpoint"
      },
      "gemini-remote": {
        "adapter": "gemini",
        "model": "gemini-embedding-2",
        "apiKeyEnv": "GEMINI_API_KEY",
        "description": "Google Gemini text embeddings (gemini-embedding-2)"
      }
    },
    "profiles": {
      "hash-local": {
        "provider": "hash-local"
      },
      "transformer-local": {
        "provider": "transformer-local"
      },
      "openai-compatible": {
        "provider": "openai-compatible-remote",
        "model": "text-embedding-3-small",
        "requestDelayMs": 1000,
        "batchSize": 1
      },
      "gemini": {
        "provider": "gemini-remote",
        "model": "gemini-embedding-2",
        "requestDelayMs": 200,
        "batchSize": 1
      }
    }
  }
}
