# Local AI Memory Bus — Environment Configuration
# Copy this file to .env and adjust for your setup.

# =============================================================================
# STORE ROOT (required)
# =============================================================================
# The root directory for all memory data (.ai-memory store).
# Defaults to ~/.ai-memory on all platforms.
AI_MEMORY_ROOT=C:\Users\wang\.ai-memory
# Aliases (also checked, in order):
# AI_MEMORY_STORE=
# AI_MEMORY_STORE_ROOT=

# =============================================================================
# PYTHON RUNTIME (optional)
# =============================================================================
# Path to Python executable for retrieval engine.
# Auto-detected if not set.
# AI_MEMORY_PYTHON=D:\python\python.exe

# =============================================================================
# EMBEDDINGS (optional — falls back to local hash embeddings)
# =============================================================================
# Embedding backend: "openai" | "hash" (default: "hash" = local LSH hash, no API needed)
# AI_MEMORY_EMBED_BACKEND=hash

# For OpenAI-compatible embedding providers:
# AI_MEMORY_EMBED_BASE_URL=https://api.openai.com/v1
# AI_MEMORY_EMBED_API_KEY=sk-your-key-here
# AI_MEMORY_EMBED_MODEL=text-embedding-3-small
# AI_MEMORY_EMBED_TIMEOUT_SECONDS=180
# AI_MEMORY_EMBED_REQUEST_DELAY_MS=1000

# =============================================================================
# MCP SERVER PORTS (optional)
# =============================================================================
# These are configured in start.js — edit that file to change ports.
# Default ports:
#   Fetch MCP:  9332
#   Time MCP:    9333
#   Memory MCP:  9338

# =============================================================================
# OBSIDIAN BACKWARD COMPATIBILITY (deprecated)
# =============================================================================
# Kept only for legacy integrations that still reference Obsidian vault.
# Not used by the core memory bus.
# AI_MEMORY_OBSIDIAN_VAULT=
# OBSIDIAN_VAULT_ROOT=