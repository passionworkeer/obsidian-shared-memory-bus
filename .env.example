# yt — Environment configuration
# Copy to .env only if your launcher loads dotenv, or export the variables in
# your shell/service manager. Do not commit real credentials.

# =============================================================================
# STORE RESOLUTION
# =============================================================================
# Preferred explicit shared-memory store root.
# If unset, the runtime may use a detected Obsidian vault's
# 00-System/ai-memory directory, AI_MEMORY_ROOT, or ~/.ai-memory as fallback.
# AI_MEMORY_STORE=/absolute/path/to/.ai-memory

# Compatibility alias for older integrations.
# AI_MEMORY_STORE_ROOT=

# Project/install root. This is not always the same as the data store root.
# AI_MEMORY_ROOT=/absolute/path/to/obsidian-shared-memory-bus

# Optional explicit Obsidian vault. Obsidian is not required.
# AI_MEMORY_OBSIDIAN_VAULT=/absolute/path/to/vault
# OBSIDIAN_VAULT_ROOT=  # legacy alias

# =============================================================================
# CORE MCP SERVICES
# =============================================================================
# Memory topology: split (default) or monolithic.
# AI_MEMORY_SERVER_MODE=split

# Core port registry base. Default is 9330.
# Offsets are currently:
#   fetch +2, time +3, memory-retrieval/legacy memory +8,
#   memory-bridge +9, memory-dream +10, memory-mgmt +11.
# AI_MEMORY_BASE_PORT=9330

# Loopback host used when generating client URLs.
# AI_MEMORY_HOST=127.0.0.1

# =============================================================================
# PYTHON RUNTIME
# =============================================================================
# Python executable for retrieval workers and Python MCP services.
# AI_MEMORY_PYTHON=python3

# =============================================================================
# EMBEDDINGS
# =============================================================================
# hash is local and requires no API. Other supported values include
# transformer, openai-compatible, and gemini.
# AI_MEMORY_EMBED_BACKEND=hash

# Remote/provider configuration. Text may leave the machine when a remote
# backend is enabled.
# AI_MEMORY_EMBED_BASE_URL=https://api.example.com/v1
# AI_MEMORY_EMBED_API_KEY=
# AI_MEMORY_EMBED_MODEL=
# AI_MEMORY_EMBED_TIMEOUT_SECONDS=180
# AI_MEMORY_EMBED_REQUEST_DELAY_MS=1000
# AI_MEMORY_EMBED_BATCH_SIZE=24

# Prefer an environment-variable name inside runtime config instead of storing
# a plaintext key in runtime.json.
# AI_MEMORY_EMBED_API_KEY_ENV=AI_MEMORY_EMBED_API_KEY

# =============================================================================
# RUNTIME CONFIG
# =============================================================================
# Optional path to runtime config JSON.
# AI_MEMORY_RUNTIME_CONFIG_PATH=

# Permit embedding-related environment variables to override runtime.json.
# AI_MEMORY_ALLOW_EMBED_RUNTIME_ENV_OVERRIDES=false

# =============================================================================
# CLAUDE-MEM BRIDGE
# =============================================================================
# CLAUDE_MEM_BASE=http://127.0.0.1:37778

# =============================================================================
# REDACTION
# =============================================================================
# AI_MEMORY_REDACTION_ENABLED=true
# AI_MEMORY_REDACTION_MODE=tools
# AI_MEMORY_REDACTION_PLACEHOLDER=[REDACTED]
