# Environment files
.env
.env.*
*.env

# Internal strategy/planning docs (author-only, not for public release)
docs/internal/

# Generated startup scripts (contain user-specific absolute paths)
shared-mcp/startup/

# Log files (can contain path/credential fragments in error messages)
*.err.log
shared-mcp/logs/*.err.log
*.log
*.tmp

# Python
__pycache__/
*.pyc
*.py[cod]
.venv/
ops/__pycache__/
retrieval/__pycache__/
*.egg-info/
.pytest_cache/

# Runtime-generated memory store artifacts (live in user store directory, not in project)
# Note: ops/adapters/generated/ contains source-code schema files — NOT gitignored
generated/
/structured/
test-e2e.jsonl

# Bundles and generated state
node_modules/
shared-mcp/node_modules/
shared-mcp/logs/
shared-mcp/generated/
shared-mcp/state.json

# Reports and cache
cache/
reports/
retrieval/eval/results.json

# Backup fragments
*.bak.*
.tmp-hidden-start-smoke.json
.tmp-old-start-smoke.json
.tmp-visible-console-node-old.json
.tmp-visible-console-old.json

# Local IDE/agent workspace overlays (machine-specific, not portable)
.claude/
.cursor/
.vscode/
.superpowers/
cursor/
cursor
.agents/
!.agents/
!.agents/skills/
!.agents/skills/*.md
.trae/

# Machine-specific client configs (contain user/environment-specific settings)
opencode.json
c8rc.json

# Template .config (duplicate of config/, use config/ instead)
templates/.memory/.config/
SUPPORT.md

# Test artifacts
.coverage
coverage/
coverage.json

# Temp debug scripts
_run_*.py
_run_*.sh

# Misc
$null
interview/

# Memory bus sync mirrors (generated, user-specific)
imported/
/inbox/
agents.json

# Debug/test scratch files
_test_*.py
_test_*.js
shared-mcp/*.debugbak
shared-mcp/*.disabled
